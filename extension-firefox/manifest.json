{
  "manifest_version": 3,
  "name": "Blockchain Explorer & Web3 Block Explorer",
  "short_name": "Web3Lens",
  "version": "1.0.0",
  "description": "Scan blockchain networks, find block explorers, look up crypto addresses and transaction hashes on 789+ blockchains with Web3Lens.",
  "homepage_url": "https://web3lens.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web3Lens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "omnibox": {
    "keyword": "w3"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open Web3Lens"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://web3lens.com"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@web3lens.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "searchTerms"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
