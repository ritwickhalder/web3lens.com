# Google Analytics 4 measurement id (optional; GA loads only when set)
NEXT_PUBLIC_GA_ID=

# Contact form (app/api/contact). Without SMTP_USER/SMTP_PASSWORD the form
# still validates and responds, but no email is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_TO=

# Accounts and Pro (docs/ACCOUNTS.md). All optional: without them the site works signed out and the
# account routes answer 503. Server-only except the NEXT_PUBLIC_ ones.
# DATABASE_URL=postgres://...neon.tech/...?sslmode=require
# BETTER_AUTH_SECRET=            # openssl rand -base64 32
# BETTER_AUTH_URL=https://web3lens.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=          # redirect URI: https://web3lens.com/api/auth/callback/google
# EXTRA_EXTENSION_IDS=           # unpacked dev extension ids, comma-separated
# PADDLE_WEBHOOK_SECRET=         # comma-separated while rotating
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_ENV=sandbox # or production
# NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
# NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
# NEXT_PUBLIC_PADDLE_PRICE_LIFETIME=
# CRON_SECRET=                   # Vercel Cron bearer for /api/cron/watches (watchlist checks)
# ADMIN_EMAILS=                  # comma-separated Google emails allowed to open /admin
# Watchlist alert emails reuse the SMTP_* settings above.

# Native lookups (all optional; free public endpoints are used without them). Server-side only:
# never prefix these with NEXT_PUBLIC_. A private RPC is tried before the public ones for that chain.
# RPC_URL_ETHEREUM=
# RPC_URL_BASE=
# RPC_URL_ARBITRUM=
# RPC_URL_OPTIMISM=
# RPC_URL_POLYGON=
# RPC_URL_BINANCECOIN=
# RPC_URL_AVALANCHE=
# RPC_URL_LINEA=
# RPC_URL_ZKSYNC=
# RPC_URL_SCROLL=
# RPC_URL_GNOSISCHAIN=
# CoinGecko demo key raises the free price-API rate limit.
# COINGECKO_DEMO_KEY=
