# Google Analytics 4 measurement id (optional; GA loads only when set)
NEXT_PUBLIC_GA_ID=

# Contact form (app/api/contact). Without SMTP_USER/SMTP_PASSWORD the form
# still validates and responds, but no email is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_TO=

# Native lookups (all optional; free public endpoints are used without them). Server-side only:
# never prefix these with NEXT_PUBLIC_. A private RPC is tried before the public ones for that chain.
# RPC_URL_ETHEREUM=
# RPC_URL_BASE=
# RPC_URL_ARBITRUM=
# RPC_URL_OPTIMISM=
# RPC_URL_POLYGON=
# RPC_URL_BINANCECOIN=
# RPC_URL_AVALANCHE=
# RPC_URL_LINEA=
# RPC_URL_ZKSYNC=
# RPC_URL_SCROLL=
# RPC_URL_GNOSISCHAIN=
# CoinGecko demo key raises the free price-API rate limit.
# COINGECKO_DEMO_KEY=
